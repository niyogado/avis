# Example environment variables for AVIS Core Backend
DATABASE_URL=postgresql+asyncpg://avis_user:strongpassword@localhost:5432/avis_db
SECRET_KEY=change_this_to_a_secure_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256
BACKEND_CORS_ORIGINS=http://localhost:3000
EJOCHAT_API_URL=https://api.ejolabs.com/api/v1/subiza
EJOCHAT_API_KEY=your_ejochat_api

# Optional: Adzuna publisher API (official; enables local-country search for ALL industries).
# Get free keys at https://developer.adzuna.com — without them AVIS reports the provider unavailable.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
